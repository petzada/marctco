generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspaceRole {
  ATTENDANT
  SUPERVISOR
  MANAGER
  OWNER

  @@map("workspace_role")
}

enum FinancingType {
  VEHICLE
  REAL_ESTATE
  PERSONAL_LOAN
  OTHER

  @@map("financing_type")
}

enum PipelineType {
  COMMERCIAL
  LEGAL

  @@map("pipeline_type")
}

enum StageRole {
  ENTRY
  CLOSING
  LEGAL_HANDOFF
  NORMAL

  @@map("stage_role")
}

enum IntegrationProvider {
  PLUGA
  LANDING_PAGE

  @@map("integration_provider")
}

enum IntegrationConnectionStatus {
  ACTIVE
  DISABLED

  @@map("integration_connection_status")
}

/// The single source of the Integrações screen: what arrived, what it became,
/// and what is still in quarantine. QUARANTINED and FAILED are written by the
/// tickets that own those paths (10 and 15); ingestion writes RECEIVED and the
/// worker writes PROCESSED.
enum IntegrationEventStatus {
  RECEIVED
  PROCESSED
  QUARANTINED
  FAILED

  @@map("integration_event_status")
}

/// The outbox half: PostgreSQL is the source of pending work, never Redis.
enum IntegrationEventDispatchStatus {
  PENDING
  DISPATCHED

  @@map("integration_event_dispatch_status")
}

model Workspace {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                    String                  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  timezone                String                  @default("America/Sao_Paulo")
  created_at              DateTime                @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                @updatedAt @db.Timestamptz(6)
  members                 WorkspaceMember[]
  pipelines               Pipeline[]
  integration_connections IntegrationConnection[]
  integration_events      IntegrationEvent[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspace_id String        @db.Uuid
  user_id      String        @db.Uuid
  role         WorkspaceRole
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  workspace    Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@id([workspace_id, user_id])
  @@index([user_id])
  @@map("workspace_members")
}

model Pipeline {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id            String                  @db.Uuid
  name                    String
  type                    PipelineType
  is_default              Boolean                 @default(false)
  created_at              DateTime                @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                @updatedAt @db.Timestamptz(6)
  workspace               Workspace               @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  stages                  Stage[]
  integration_connections IntegrationConnection[] @relation("IntegrationConnectionTargetPipeline")

  @@unique([workspace_id, id])
  @@index([workspace_id])
  @@map("pipelines")
}

model IntegrationConnection {
  id                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id       String                      @db.Uuid
  provider           IntegrationProvider
  contract_version   String                      @default("v1")
  token_hash         String                      @unique @db.Char(64)
  token_last4        String                      @db.Char(4)
  status             IntegrationConnectionStatus @default(ACTIVE)
  target_pipeline_id String?                     @db.Uuid
  created_at         DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                    @updatedAt @db.Timestamptz(6)
  workspace          Workspace                   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  target_pipeline    Pipeline?                   @relation("IntegrationConnectionTargetPipeline", fields: [workspace_id, target_pipeline_id], references: [workspace_id, id], onDelete: Restrict)
  events             IntegrationEvent[]

  @@unique([workspace_id, provider])
  @@unique([workspace_id, id])
  @@index([workspace_id])
  @@map("integration_connections")
}

model IntegrationEvent {
  id                        String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id              String                         @db.Uuid
  integration_connection_id String                         @db.Uuid
  /// The single copy of the payload. Nullable, and null can only ever mean
  /// expired: it is written on receipt, before the 200 (ADR-0014).
  raw                       Json?                          @db.JsonB
  status                    IntegrationEventStatus         @default(RECEIVED)
  dispatch_status           IntegrationEventDispatchStatus @default(PENDING)
  received_at               DateTime                       @default(now()) @db.Timestamptz(6)
  dispatched_at             DateTime?                      @db.Timestamptz(6)
  processed_at              DateTime?                      @db.Timestamptz(6)
  updated_at                DateTime                       @updatedAt @db.Timestamptz(6)
  workspace                 Workspace                      @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  integration_connection    IntegrationConnection          @relation(fields: [workspace_id, integration_connection_id], references: [workspace_id, id], onDelete: Restrict)

  @@index([workspace_id])
  @@index([dispatch_status, received_at])
  @@map("integration_events")
}

model Stage {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String    @db.Uuid
  pipeline_id  String    @db.Uuid
  label        String
  position     Int
  role         StageRole @default(NORMAL)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)
  pipeline     Pipeline  @relation(fields: [workspace_id, pipeline_id], references: [workspace_id, id], onDelete: Cascade)

  @@unique([pipeline_id, position])
  @@index([workspace_id])
  @@index([workspace_id, pipeline_id])
  @@map("stages")
}
