generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspaceRole {
  ATTENDANT
  SUPERVISOR
  MANAGER
  OWNER

  @@map("workspace_role")
}

/// Status of the WorkspaceMember association. Detaching and dismissing both
/// write DETACHED; there is no third "dismissed" value (ADR-0023).
enum WorkspaceMemberStatus {
  ACTIVE
  DETACHED

  @@map("workspace_member_status")
}

enum FinancingType {
  VEHICLE
  REAL_ESTATE
  PERSONAL_LOAN
  OTHER

  @@map("financing_type")
}

enum PipelineType {
  COMMERCIAL
  LEGAL

  @@map("pipeline_type")
}

enum StageRole {
  ENTRY
  CLOSING
  LEGAL_HANDOFF
  NORMAL

  @@map("stage_role")
}

enum IntegrationProvider {
  PLUGA
  LANDING_PAGE
  WHATSMIAU

  @@map("integration_provider")
}

/// Local normalization of Whatsmiau Cloud API v2 pairing. Distinct from
/// IntegrationConnectionStatus (ACTIVE / DISABLED). ERROR is ours, never a
/// provider value (ADR-0005).
enum WhatsAppPairingState {
  DISCONNECTED
  CONNECTING
  QR_PENDING
  CONNECTED
  SUSPENDED
  ERROR

  @@map("whatsapp_pairing_state")
}

enum IntegrationConnectionStatus {
  ACTIVE
  DISABLED

  @@map("integration_connection_status")
}

/// The single source of the Integrações screen: what arrived, what it became,
/// and what is still in quarantine. QUARANTINED and FAILED are written by the
/// tickets that own those paths (10 and 15); ingestion writes RECEIVED and the
/// worker writes PROCESSED.
enum IntegrationEventStatus {
  RECEIVED
  PROCESSED
  QUARANTINED
  FAILED

  @@map("integration_event_status")
}

/// The outbox half: PostgreSQL is the source of pending work, never Redis.
enum IntegrationEventDispatchStatus {
  PENDING
  DISPATCHED

  @@map("integration_event_dispatch_status")
}

/// Where a submission came from. Half of the idempotency key, which is why it
/// is an enum and not free text: a source that spells itself two ways
/// deduplicates nothing. Never confused with `IntegrationProvider`, which is
/// *which connection* the event entered through (ADR-0005).
enum LeadSource {
  META_LEAD_ADS
  GOOGLE_LEAD_FORM
  LANDING_PAGE

  @@map("lead_source")
}

/// Orthogonal to the stage: winning and losing take the card off the Kanban,
/// they are not columns of it (ADR-0009).
enum OpportunityStatus {
  OPEN
  WON
  LOST

  @@map("opportunity_status")
}

/// Commercial or legal. Never `department` (ADR-0002 avoids "departamento").
enum OpportunityArea {
  COMMERCIAL
  LEGAL

  @@map("opportunity_area")
}

/// A pendency hung on an Opportunity that already exists. Marker, never gate.
enum IntakeReviewType {
  IDENTITY_CONFLICT
  POSSIBLE_DUPLICATE

  @@map("intake_review_type")
}

/// Audit-safe outcomes of a possible-duplicate review. Identity-conflict
/// resolutions are a separate decision and cannot be stored in this enum.
enum PossibleDuplicateResolution {
  NEW_FINANCING
  SAME_FINANCING
  INVALID_OR_SPAM

  @@map("possible_duplicate_resolution")
}

/// Audit-safe outcomes of an identity-conflict review (ticket 12). A
/// separate enum from `PossibleDuplicateResolution`: merging into a
/// candidate or confirming distinct people never applies to a
/// POSSIBLE_DUPLICATE row, and the reverse.
enum IdentityConflictResolution {
  MERGED
  CONFIRMED_DISTINCT

  @@map("identity_conflict_resolution")
}

/// Ingestion facts this slice must expose on an Opportunity timeline, plus
/// the movement facts Fase 3 records. Movement kinds have no integration
/// event and do not deduplicate.
enum OpportunityTimelineEventType {
  RETRANSMISSION_RECEIVED
  SUBMISSION_REENTERED
  STAGE_CHANGED
  ASSIGNED
  REASSIGNED
  RETURNED_TO_QUEUE
  ACTIVITY_CREATED
  ACTIVITY_COMPLETED
  WHATSAPP_OUTBOUND_SENT
  WHATSAPP_OUTBOUND_FAILED
  WHATSAPP_INBOUND_RECEIVED

  @@map("opportunity_timeline_event_type")
}

model Workspace {
  id                          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                        String                     @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                        String
  timezone                    String                     @default("America/Sao_Paulo")
  created_at                  DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                   @updatedAt @db.Timestamptz(6)
  members                     WorkspaceMember[]
  pipelines                   Pipeline[]
  integration_connections     IntegrationConnection[]
  integration_events          IntegrationEvent[]
  persons                     Person[]
  lead_submissions            LeadSubmission[]
  opportunities               Opportunity[]
  intake_reviews              IntakeReview[]
  opportunity_timeline_events OpportunityTimelineEvent[]
  feature_flags               WorkspaceFlag[]
  tags                        Tag[]
  activities                  Activity[]
  notifications               Notification[]
  settings                    WorkspaceSettings?
  channel_outbound_attempts   ChannelOutboundAttempt[]

  @@map("workspaces")
}

/// A row is a commercial/technical release for one paid-per-use capability.
/// No row means OFF; the catalog itself stays in packages/domain (ADR-0004).
model WorkspaceFlag {
  workspace_id String    @db.Uuid
  key          String
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@id([workspace_id, key])
  @@map("workspace_flags")
}

model WorkspaceMember {
  workspace_id          String                 @db.Uuid
  user_id               String                 @db.Uuid
  role                  WorkspaceRole
  status                WorkspaceMemberStatus  @default(ACTIVE)
  /// Denormalized so Equipe and the assignee name list without Auth per row.
  display_name          String?
  email                 String?
  /// Optional. Same phone reader as ingestion. WhatsApp dispatch is Fase 4.
  whatsapp_phone_e164   String?
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  workspace             Workspace              @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  member_tags           MemberTag[]
  assigned_activities   Activity[] @relation("ActivityAssignee")
  created_activities    Activity[] @relation("ActivityAuthor")
  completed_activities  Activity[] @relation("ActivityCompletedBy")
  timeline_assigned_events OpportunityTimelineEvent[] @relation("TimelineAssignedMember")
  timeline_previous_assigned_events OpportunityTimelineEvent[] @relation("TimelinePreviousAssignedMember")
  read_notifications    Notification[] @relation("NotificationReadBy")

  @@id([workspace_id, user_id])
  @@index([user_id])
  @@map("workspace_members")
}

/// Catalog of the workspace, managed in Equipe in the same gesture as
/// attaching a collaborator. Uniqueness is (workspace_id, lower(name)) and
/// lives only in the migration: the schema DSL cannot express an expression
/// unique index (ADR-0005, ADR-0020).
model Tag {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String      @db.Uuid
  name         String
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  workspace    Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  members      MemberTag[]

  @@unique([workspace_id, id])
  @@index([workspace_id])
  @@map("tags")
}

/// Application of a Tag to a WorkspaceMember. This is what computes a
/// Supervisor's team. Never inherited by Opportunity (ADR-0020).
model MemberTag {
  workspace_id String          @db.Uuid
  user_id      String          @db.Uuid
  tag_id       String          @db.Uuid
  created_at   DateTime        @default(now()) @db.Timestamptz(6)
  member       WorkspaceMember @relation(fields: [workspace_id, user_id], references: [workspace_id, user_id], onDelete: Cascade)
  tag          Tag             @relation(fields: [workspace_id, tag_id], references: [workspace_id, id], onDelete: Cascade)

  @@id([workspace_id, user_id, tag_id])
  @@index([workspace_id, tag_id])
  @@map("member_tags")
}

model Pipeline {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id            String                  @db.Uuid
  name                    String
  type                    PipelineType
  is_default              Boolean                 @default(false)
  created_at              DateTime                @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                @updatedAt @db.Timestamptz(6)
  workspace               Workspace               @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  stages                  Stage[]
  opportunities           Opportunity[]
  integration_connections IntegrationConnection[] @relation("IntegrationConnectionTargetPipeline")

  @@unique([workspace_id, id])
  @@index([workspace_id])
  @@map("pipelines")
}

model IntegrationConnection {
  id                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id       String                      @db.Uuid
  provider           IntegrationProvider
  contract_version   String                      @default("v1")
  token_hash         String                      @unique @db.Char(64)
  token_last4        String                      @db.Char(4)
  status             IntegrationConnectionStatus @default(ACTIVE)
  target_pipeline_id String?                     @db.Uuid
  /// Public WhatsMiau instanceName. Null on Pluga and landing page.
  instance_name      String?                     @unique
  /// Pairing with the provider. Null on Pluga and landing page.
  pairing_state      WhatsAppPairingState?
  created_at         DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                    @updatedAt @db.Timestamptz(6)
  workspace          Workspace                   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  target_pipeline    Pipeline?                   @relation("IntegrationConnectionTargetPipeline", fields: [workspace_id, target_pipeline_id], references: [workspace_id, id], onDelete: Restrict)
  events             IntegrationEvent[]
  timeline_events    OpportunityTimelineEvent[]

  @@unique([workspace_id, provider])
  @@unique([workspace_id, id])
  @@index([workspace_id])
  @@map("integration_connections")
}

// Ticket 02 of Canal: at most one live WhatsMiau connection per workspace is a
// migration-only partial unique index
// (`provider = WHATSMIAU AND status <> DISABLED`). Prisma's @@index cannot
// express WHERE, and restoring UNIQUE(workspace_id, provider) as the only
// rule would contradict ADR-0031. The global unique above still exists until
// ticket 19 drops it; the partial is the WhatsMiau exception that survives.

model IntegrationEvent {
  id                          String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id                String                         @db.Uuid
  integration_connection_id   String                         @db.Uuid
  /// The single copy of the payload. Nullable, and null can only ever mean
  /// expired: it is written on receipt, before the 200 (ADR-0014).
  raw                         Json?                          @db.JsonB
  status                      IntegrationEventStatus         @default(RECEIVED)
  dispatch_status             IntegrationEventDispatchStatus @default(PENDING)
  received_at                 DateTime                       @default(now()) @db.Timestamptz(6)
  dispatched_at               DateTime?                      @db.Timestamptz(6)
  processed_at                DateTime?                      @db.Timestamptz(6)
  /// The dead letter, written only when BullMQ exhausted the job's attempts
  /// (ticket 15). Sanitized and truncated by `markIntegrationEventFailed`: the
  /// worker fails with the raw payload in scope, and the reason outlives the
  /// 90-day expiry (ADR-0006 regra 12, ADR-0014).
  failed_at                   DateTime?                      @db.Timestamptz(6)
  failure_reason              String?
  updated_at                  DateTime                       @updatedAt @db.Timestamptz(6)
  workspace                   Workspace                      @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  integration_connection      IntegrationConnection          @relation(fields: [workspace_id, integration_connection_id], references: [workspace_id, id], onDelete: Restrict)
  lead_submissions            LeadSubmission[]
  opportunity_timeline_events OpportunityTimelineEvent[]

  @@unique([workspace_id, id])
  @@index([workspace_id])
  @@index([dispatch_status, received_at])
  @@index([workspace_id, received_at(sort: Desc), id(sort: Desc)])
  // Ticket 15 adds two partial indexes that live only in the migration, for the
  // same reason the Leads ones do: the schema DSL has no `WHERE` on `@@index`,
  // and declaring them here would claim a full index that migration history
  // never created. `integration_events_workspace_id_failed_at_id_idx`
  // `(workspace_id, failed_at DESC, id DESC) WHERE status = 'FAILED'` backs the
  // dead-letter list; `integration_events_expiring_payload_idx`
  // `(workspace_id, received_at) WHERE raw IS NOT NULL AND status <>
  // 'QUARANTINED'` backs the payload expiry sweep.
  @@map("integration_events")
}

/// The single record of a physical or legal person in the workspace, with zero
/// or one valid CPF and many normalized phones and e-mails. Never `Contact`
/// (ADR-0005).
///
/// There is deliberately no unique constraint on `cpf`: keys that point at
/// different Pessoas create a new one rather than fusing, so two rows may carry
/// the same CPF while a human has not resolved the conflict yet (ADR-0007).
model Person {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id          String        @db.Uuid
  name                  String?
  /// Digits only, check digits verified before it is written. `text` and not
  /// `char(11)`: blank padding would make a lookup key that no longer equals
  /// itself once it leaves the database.
  cpf                   String?
  /// The tombstone a non-destructive merge leaves behind. It does exactly two
  /// things — take the row out of active views and preserve the trail — and
  /// never a third: it never redirects a read (ADR-0007).
  merged_into_person_id String?       @db.Uuid
  created_at            DateTime      @default(now()) @db.Timestamptz(6)
  updated_at            DateTime      @updatedAt @db.Timestamptz(6)
  workspace             Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  /// `NoAction` and not `Restrict`: a tombstone must not be deletable while
  /// the canonical row it points at still exists, but deleting a whole
  /// workspace removes both in one statement, and `Restrict` fires per row and
  /// would deadlock that cascade against itself.
  merged_into           Person?       @relation("PersonMerge", fields: [workspace_id, merged_into_person_id], references: [workspace_id, id], onDelete: NoAction, onUpdate: NoAction)
  absorbed              Person[]      @relation("PersonMerge")
  phones                PersonPhone[]
  emails                PersonEmail[]
  opportunities         Opportunity[]

  @@unique([workspace_id, id])
  @@index([workspace_id])
  @@index([workspace_id, cpf])
  @@index([workspace_id, merged_into_person_id])
  @@map("persons")
}

/// Many per Person, normalized to E.164. Receiving a new one never overwrites
/// an earlier one — the uniqueness is on the pair, so the write is an insert
/// that does nothing on conflict (ADR-0007 §Identidade).
model PersonPhone {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String   @db.Uuid
  person_id    String   @db.Uuid
  phone_e164   String
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  person       Person   @relation(fields: [workspace_id, person_id], references: [workspace_id, id], onDelete: Cascade)

  @@unique([person_id, phone_e164])
  @@index([workspace_id])
  @@index([workspace_id, phone_e164])
  @@index([workspace_id, person_id])
  @@map("person_phones")
}

/// Many per Person, normalized to lowercase. Same non-destructive rule as
/// `PersonPhone`.
model PersonEmail {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String   @db.Uuid
  person_id    String   @db.Uuid
  email        String
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  person       Person   @relation(fields: [workspace_id, person_id], references: [workspace_id, id], onDelete: Cascade)

  @@unique([person_id, email])
  @@index([workspace_id])
  @@index([workspace_id, email])
  @@index([workspace_id, person_id])
  @@map("person_emails")
}

model Stage {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id  String        @db.Uuid
  pipeline_id   String        @db.Uuid
  label         String
  position      Int
  role          StageRole     @default(NORMAL)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @updatedAt @db.Timestamptz(6)
  pipeline      Pipeline      @relation(fields: [workspace_id, pipeline_id], references: [workspace_id, id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipeline_id, position])
  @@unique([workspace_id, id])
  @@index([workspace_id])
  @@index([workspace_id, pipeline_id])
  @@map("stages")
}

/// Each form submission received, and the one thing that answers "have I seen
/// this transmission before" — `UNIQUE(workspace_id, source, external_lead_id)`,
/// arbitrated by the constraint and never by a `SELECT` that came first.
///
/// Deliberately **without `raw`**: the payload is stored once, on the
/// `IntegrationEvent`, and the submission points at the most recent
/// transmission instead of repeating the content (ADR-0014).
model LeadSubmission {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id              String                     @db.Uuid
  source                    LeadSource
  /// `NOT NULL` always: in Postgres `NULL` does not collide with `NULL`, so
  /// without a value the constraint would deduplicate nothing. When the origin
  /// supplies none, the connector uses the `IntegrationEvent.id`.
  external_lead_id          String                     @db.VarChar(255)
  /// Truth about the origin. Not the Opportunity's `arrived_at`, which is the
  /// release instant for a lead that went through quarantine.
  received_at               DateTime                   @default(now()) @db.Timestamptz(6)
  last_integration_event_id String                     @db.Uuid
  /// How many times this submission has arrived. A resend increments it and
  /// touches nothing else in the funnel.
  transmission_count        Int                        @default(1)
  /// Null while the submission produced no card — quarantine, or a plan that
  /// has not been applied yet.
  opportunity_id            String?                    @db.Uuid
  /// Evidence from the `v1` contract. The connector translates; it never
  /// infers consent from a phone, campaign or provider (ADR-0008).
  whatsapp_opt_in           Boolean?
  created_at                DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                   @updatedAt @db.Timestamptz(6)
  workspace                 Workspace                  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  last_integration_event    IntegrationEvent           @relation(fields: [workspace_id, last_integration_event_id], references: [workspace_id, id], onDelete: Restrict)
  opportunity               Opportunity?               @relation(fields: [workspace_id, opportunity_id], references: [workspace_id, id], onDelete: NoAction, onUpdate: NoAction)
  timeline_events           OpportunityTimelineEvent[]

  @@unique([workspace_id, source, external_lead_id])
  @@unique([workspace_id, id])
  @@index([workspace_id])
  @@index([workspace_id, opportunity_id])
  @@index([workspace_id, last_integration_event_id])
  @@map("lead_submissions")
}

/// The business tied to a Person, in a stage of a pipeline. On the commercial
/// UI it is called Lead — never `Deal`, never a `Lead` model (ADR-0005).
model Opportunity {
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id               String                     @db.Uuid
  person_id                  String                     @db.Uuid
  pipeline_id                String                     @db.Uuid
  stage_id                   String                     @db.Uuid
  area                       OpportunityArea
  status                     OpportunityStatus          @default(OPEN)
  /// When the Opportunity comes to exist and the attendance clock may start.
  /// Written from the day ingestion exists, though the SLA screen is Fase 3:
  /// this instant is not reconstructible later (ADR-0007 §Mecanismo 2).
  arrived_at                 DateTime                   @db.Timestamptz(6)
  /// Born null — assignment is Fase 2.
  assigned_user_id           String?                    @db.Uuid
  /// The assignee displaced by a reassignment or by membership detachment.
  /// This is historical context only and never participates in access scope.
  previous_assigned_user_id  String?                    @db.Uuid
  /// Means one thing only: no WhatsApp and no phone call. Not a generic
  /// "something is missing" label (ADR-0007 §Quarentena).
  missing_phone              Boolean                    @default(false)
  /// Snapshot of the submission that created or released this card.
  /// Automatic WhatsApp dispatch requires true; absent or false fails closed.
  whatsapp_opt_in            Boolean?
  /// Classification of the credit contract that motivated the contact. Never
  /// selects a pipeline, never identifies a Pessoa.
  financing_type             FinancingType?
  financial_institution      String?
  /// Unconstrained `numeric`: the normalized decimal is stored exactly as the
  /// domain produced it, and a mis-mapped field carrying an absurd number can
  /// never overflow a column and cost the lead the whole write.
  installment_amount         Decimal?                   @db.Decimal
  /// Media attribution from the `v1` contract. Persisted at intake because the
  /// raw payload expires in 90 days (ADR-0014). Does not route the lead
  /// (ADR-0022). A retransmission has nowhere to write these (ADR-0007).
  campaign_id                String?
  campaign_name              String?
  form_id                    String?
  form_name                  String?
  /// The tombstone of a `SAME_FINANCING` resolution (ticket 11). It takes the
  /// row out of active views and preserves the trail, and never redirects a
  /// read.
  merged_into_opportunity_id String?                    @db.Uuid
  created_at                 DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                   @updatedAt @db.Timestamptz(6)
  /// Instant of the first evidence of attendance. Written once: first
  /// completed Activity, HTTP 2xx of automatic WhatsApp sendText, or inbound
  /// reply. Assignment, enqueue and a failed send never write it.
  first_contact_at           DateTime?                  @db.Timestamptz(6)
  /// Instant the Opportunity became WON or LOST. Null while OPEN; required
  /// when closed (DB CHECK). Ends the first-contact SLA when there was no
  /// attendance. Fase 6's close operation fills this; quarantine archive paths
  /// that already close the card write it too (ticket 03).
  closed_at                  DateTime?                  @db.Timestamptz(6)
  /// Instant of the last movement. Nullable; backfilled to arrived_at so a
  /// lead that was never touched is the most stagnant, not the least.
  last_movement_at           DateTime?                  @db.Timestamptz(6)
  workspace                  Workspace                  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  person                     Person                     @relation(fields: [workspace_id, person_id], references: [workspace_id, id], onDelete: Cascade)
  pipeline                   Pipeline                   @relation(fields: [workspace_id, pipeline_id], references: [workspace_id, id], onDelete: Restrict)
  stage                      Stage                      @relation(fields: [workspace_id, stage_id], references: [workspace_id, id], onDelete: Restrict)
  merged_into                Opportunity?               @relation("OpportunityMerge", fields: [workspace_id, merged_into_opportunity_id], references: [workspace_id, id], onDelete: NoAction, onUpdate: NoAction)
  absorbed                   Opportunity[]              @relation("OpportunityMerge")
  submissions                LeadSubmission[]
  reviews                    IntakeReview[]             @relation("IntakeReviewOpportunity")
  related_reviews            IntakeReview[]             @relation("IntakeReviewRelatedOpportunity")
  timeline_events            OpportunityTimelineEvent[]
  activities                 Activity[]
  notifications              Notification[]
  channel_outbound_attempts  ChannelOutboundAttempt[]

  // Two partial indexes back the Leads screen (ticket 12), declared only in
  // the migration: `opportunities_workspace_id_arrived_at_id_active_idx`
  // `(workspace_id, arrived_at DESC, id DESC) WHERE merged_into_opportunity_id
  // IS NULL` for the keyset list, and `opportunities_missing_phone_active_idx
  // (workspace_id) WHERE missing_phone AND NOT merged` for that marker's
  // counter/filter. The Prisma schema DSL cannot express a `WHERE` predicate
  // on `@@index`, the same reason `intake_reviews_workspace_id_opportunity_id_idx`
  // below has never appeared here either (ticket 11) — writing one anyway
  // would declare a full, unpartitioned index that does not match migration
  // history, not the partial one actually created.
  // Ticket 04 adds another migration-only partial index on
  // `(workspace_id, assigned_user_id) WHERE status = 'OPEN' AND assigned_user_id
  // IS NOT NULL` for returning a departing member's active work to the queue.
  // Ticket 03 (first-contact clock) adds a migration-only partial index on
  // `(workspace_id, arrived_at) WHERE first_contact_at IS NULL AND status =
  // 'OPEN' AND merged_into_opportunity_id IS NULL` — the Prisma schema DSL
  // cannot express a WHERE predicate on @@index.
  // Ticket 04 (stagnation) adds a migration-only partial index on
  // `(workspace_id, last_movement_at) WHERE status = 'OPEN' AND
  // merged_into_opportunity_id IS NULL`.
  @@unique([workspace_id, id])
  @@index([workspace_id])
  @@index([workspace_id, person_id])
  @@index([workspace_id, stage_id])
  @@index([workspace_id, merged_into_opportunity_id])
  @@map("opportunities")
}

/// A pendency hung on an Opportunity that already exists and can already be
/// attended. It signals, it never blocks, and it is always resolvable.
model IntakeReview {
  id                     String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id           String                       @db.Uuid
  opportunity_id         String                       @db.Uuid
  type                   IntakeReviewType
  /// The Pessoas the submission's keys pointed at, for `IDENTITY_CONFLICT`.
  /// Empty for the other type — the database refuses the mismatch.
  candidate_person_ids   String[]                     @default([]) @db.Uuid
  /// The other open Opportunity of the same Pessoa, for `POSSIBLE_DUPLICATE`.
  related_opportunity_id String?                      @db.Uuid
  /// Null while pending. The audit columns below are all-null or all-present;
  /// the database refuses a half-resolved review. Applies only to
  /// POSSIBLE_DUPLICATE rows — never set together with
  /// `identity_conflict_resolution` (ticket 12).
  resolution             PossibleDuplicateResolution?
  /// Ticket 12: the identity-conflict half of "a resolução acontece aqui" —
  /// merge into a candidate or confirm distinct people. Applies only to
  /// IDENTITY_CONFLICT rows.
  identity_conflict_resolution IdentityConflictResolution?
  resolved_by_user_id    String?                      @db.Uuid
  resolved_at            DateTime?                    @db.Timestamptz(6)
  resolution_reason      String?
  created_at             DateTime                     @default(now()) @db.Timestamptz(6)
  workspace              Workspace                    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  opportunity            Opportunity                  @relation("IntakeReviewOpportunity", fields: [workspace_id, opportunity_id], references: [workspace_id, id], onDelete: Cascade)
  related_opportunity    Opportunity?                 @relation("IntakeReviewRelatedOpportunity", fields: [workspace_id, related_opportunity_id], references: [workspace_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspace_id])
  @@index([workspace_id, type])
  @@map("intake_reviews")
}

/// Durable timeline of an Opportunity. Ingestion facts keep an integration
/// event and continue to deduplicate; movement facts do not.
model OpportunityTimelineEvent {
  id                   String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id         String                       @db.Uuid
  opportunity_id       String                       @db.Uuid
  type                 OpportunityTimelineEventType
  /// Present on the two ingestion variants; null on a movement fact.
  lead_submission_id   String?                      @db.Uuid
  /// Present on the two ingestion variants; null on a movement fact.
  integration_event_id String?                      @db.Uuid
  occurred_at          DateTime                     @db.Timestamptz(6)
  /// Frozen destination of ASSIGNED / REASSIGNED. Null on other types and
  /// on facts that existed before the column.
  assigned_user_id     String?                      @db.Uuid
  /// Frozen previous owner of REASSIGNED / RETURNED_TO_QUEUE. Null on other
  /// types and on facts that existed before the column.
  previous_assigned_user_id String?                 @db.Uuid
  /// Present on WHATSAPP_INBOUND_RECEIVED; the connection that authenticated
  /// the webhook. Null on every other fact type.
  integration_connection_id String?                 @db.Uuid
  /// Provider `data.key.id`. Null except on inbound message facts.
  external_message_id  String?
  /// Truncated preview, never a full thread. Null except on inbound facts.
  message_preview      String?
  created_at           DateTime                     @default(now()) @db.Timestamptz(6)
  workspace            Workspace                    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  opportunity          Opportunity                  @relation(fields: [workspace_id, opportunity_id], references: [workspace_id, id], onDelete: NoAction, onUpdate: NoAction)
  lead_submission      LeadSubmission?              @relation(fields: [workspace_id, lead_submission_id], references: [workspace_id, id], onDelete: NoAction, onUpdate: NoAction)
  integration_event    IntegrationEvent?            @relation(fields: [workspace_id, integration_event_id], references: [workspace_id, id], onDelete: NoAction, onUpdate: NoAction)
  assigned_member      WorkspaceMember?             @relation("TimelineAssignedMember", fields: [workspace_id, assigned_user_id], references: [workspace_id, user_id], onDelete: Restrict)
  previous_assigned_member WorkspaceMember?         @relation("TimelinePreviousAssignedMember", fields: [workspace_id, previous_assigned_user_id], references: [workspace_id, user_id], onDelete: Restrict)
  integration_connection IntegrationConnection?     @relation(fields: [workspace_id, integration_connection_id], references: [workspace_id, id], onDelete: Restrict)

  // Uniqueness `(workspace_id, type, integration_event_id)` is a partial
  // unique index on the two ingestion variants only, declared in the
  // ticket 04 migration. Prisma's @@unique cannot express a WHERE predicate;
  // writing one here would claim a full unique index that would reject two
  // identical movement facts. Inbound dedupe `(workspace_id,
  // integration_connection_id, external_message_id) WHERE type =
  // WHATSAPP_INBOUND_RECEIVED` is likewise migration-only.
  @@index([workspace_id])
  @@index([workspace_id, opportunity_id, occurred_at(sort: Desc), id(sort: Desc)])
  @@index([workspace_id, lead_submission_id])
  @@index([workspace_id, integration_event_id])
  @@index([workspace_id, assigned_user_id])
  @@index([workspace_id, previous_assigned_user_id])
  @@index([workspace_id, integration_connection_id])
  @@map("opportunity_timeline_events")
}

enum ChannelOutboundAttemptKind {
  AUTO_FIRST_CONTACT

  @@map("channel_outbound_attempt_kind")
}

enum ChannelOutboundDispatchStatus {
  PENDING
  DISPATCHED

  @@map("channel_outbound_dispatch_status")
}

enum ChannelOutboundDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED

  @@map("channel_outbound_delivery_status")
}

enum ChannelOutboundFailureReason {
  INSTANCE_NOT_CONNECTED
  ATTENDANT_PHONE_MISSING
  KNOWN_REFUSAL
  UNCERTAIN_EXTERNAL

  @@map("channel_outbound_failure_reason")
}

/// One automatic first-contact WhatsApp attempt per Opportunity. This row is
/// the Postgres outbox: publication (`dispatch_status`) is recoverable
/// before HTTP; delivery after PROCESSING never returns to the queue.
model ChannelOutboundAttempt {
  id                      String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id            String                         @db.Uuid
  opportunity_id          String                         @db.Uuid
  kind                    ChannelOutboundAttemptKind     @default(AUTO_FIRST_CONTACT)
  dispatch_status         ChannelOutboundDispatchStatus  @default(PENDING)
  delivery_status         ChannelOutboundDeliveryStatus  @default(QUEUED)
  failure_reason          ChannelOutboundFailureReason?
  /// Optional provider identifier. Null unless the adapter supplied one;
  /// sendText does not document a response id, so SENT may stay null.
  provider_message_id     String?
  dispatch_lease_until    DateTime?                      @db.Timestamptz(6)
  processing_lease_until  DateTime?                      @db.Timestamptz(6)
  dispatched_at           DateTime?                      @db.Timestamptz(6)
  sent_at                 DateTime?                      @db.Timestamptz(6)
  failed_at               DateTime?                      @db.Timestamptz(6)
  created_at              DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                       @updatedAt @db.Timestamptz(6)
  workspace               Workspace                      @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  opportunity             Opportunity                    @relation(fields: [workspace_id, opportunity_id], references: [workspace_id, id], onDelete: Cascade)

  @@unique([workspace_id, id])
  @@unique([workspace_id, opportunity_id, kind])
  @@index([workspace_id])
  // Pending-dispatch and processing-lease partial indexes live only in the
  // migration: Prisma's @@index cannot express WHERE, and the claim function
  // is the only reader of those predicates.
  @@map("channel_outbound_attempts")
}

/// Work the attendant records on a Lead. There is no orphan event: every
/// row has an Opportunity. MESSAGE covers WhatsApp later without a new enum
/// value; DONE proves attendance and CANCELED does not (ADR-0005).
enum ActivityType {
  CALL
  MESSAGE
  MEETING
  TASK

  @@map("activity_type")
}

enum ActivityStatus {
  OPEN
  DONE
  CANCELED

  @@map("activity_status")
}

model Activity {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id         String         @db.Uuid
  opportunity_id       String         @db.Uuid
  assigned_user_id     String         @db.Uuid
  type                 ActivityType
  title                String
  notes                String?
  due_at               DateTime       @db.Timestamptz(6)
  status               ActivityStatus @default(OPEN)
  completed_at         DateTime?      @db.Timestamptz(6)
  completed_by_user_id String?        @db.Uuid
  canceled_at          DateTime?      @db.Timestamptz(6)
  created_by_user_id   String         @db.Uuid
  created_at           DateTime       @default(now()) @db.Timestamptz(6)
  updated_at           DateTime       @updatedAt @db.Timestamptz(6)
  workspace            Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  opportunity          Opportunity    @relation(fields: [workspace_id, opportunity_id], references: [workspace_id, id], onDelete: Cascade)
  assigned_member      WorkspaceMember @relation("ActivityAssignee", fields: [workspace_id, assigned_user_id], references: [workspace_id, user_id], onDelete: Restrict)
  created_by_member    WorkspaceMember @relation("ActivityAuthor", fields: [workspace_id, created_by_user_id], references: [workspace_id, user_id], onDelete: Restrict)
  completed_by_member  WorkspaceMember? @relation("ActivityCompletedBy", fields: [workspace_id, completed_by_user_id], references: [workspace_id, user_id], onDelete: Restrict)

  // Partial index of open activities by responsible lives only in the
  // migration: `(workspace_id, assigned_user_id, due_at) WHERE status = 'OPEN'`.
  // The Prisma schema DSL cannot express a WHERE predicate on @@index.
  @@unique([workspace_id, id])
  @@index([workspace_id, due_at, id])
  @@index([workspace_id, opportunity_id, due_at])
  @@map("activities")
}

/// When the automatic first WhatsApp fires. Absence of a stored value is
/// ON_ASSIGNMENT, never DISABLED (ADR-0003, ADR-0004).
enum FirstContactTrigger {
  ON_ASSIGNMENT
  ON_ARRIVAL
  DISABLED

  @@map("first_contact_trigger")
}

/// Optional operational clocks for one workspace. No row means the domain
/// defaults, never "SLA off". The row is born on the first write from
/// Configurações — provision_workspace does not create it.
model WorkspaceSettings {
  workspace_id                  String               @id @db.Uuid
  first_contact_sla_minutes     Int?
  stagnation_days               Int?
  first_contact_trigger         FirstContactTrigger?
  first_contact_template_body   String?              @db.Text
  created_at                    DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime             @updatedAt @db.Timestamptz(6)
  workspace                     Workspace            @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("workspace_settings")
}

/// Persistable management alert on an Opportunity. One row per lead and
/// type: the sweep upserts `last_detected_at` and never invents a second
/// line. No recipient column — who sees it is profile scope (ADR-0005).
enum NotificationType {
  FIRST_CONTACT_SLA_BREACHED
  STAGNANT

  @@map("notification_type")
}

model Notification {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id     String           @db.Uuid
  opportunity_id   String           @db.Uuid
  type             NotificationType
  detected_at      DateTime         @db.Timestamptz(6)
  last_detected_at DateTime         @db.Timestamptz(6)
  read_at          DateTime?        @db.Timestamptz(6)
  read_by_user_id  String?          @db.Uuid
  resolved_at      DateTime?        @db.Timestamptz(6)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  workspace        Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  opportunity      Opportunity      @relation(fields: [workspace_id, opportunity_id], references: [workspace_id, id], onDelete: Cascade)
  read_by_member   WorkspaceMember? @relation("NotificationReadBy", fields: [workspace_id, read_by_user_id], references: [workspace_id, user_id], onDelete: Restrict)

  // Partial index of unresolved rows by detected_at lives only in the
  // migration: `(workspace_id, detected_at DESC) WHERE resolved_at IS NULL`.
  // The Prisma schema DSL cannot express a WHERE predicate on @@index.
  @@unique([workspace_id, opportunity_id, type])
  @@index([workspace_id])
  @@map("notifications")
}
