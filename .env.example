# Local development only. Production URLs belong in GitHub Environment or Railway.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/marctco?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/marctco?schema=public"
PGBOUNCER_DATABASE_URL="postgresql://postgres:postgres@localhost:64329/marctco?schema=public&pgbouncer=true&connection_limit=1"
REDIS_URL="redis://localhost:63799"

# Runtime configuration. Keep secret values out of this file.
SENTRY_DSN=""
PORT="3000"

# Added by later authentication tickets.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Optional pacing of the scheduled routines in the web process.
# Left unset, the outbox is swept every 2s (backing off to 5 min while the queue
# is unreachable), the 90-day payload expiry runs hourly, and the opportunity
# clocks (SLA / stagnation notifications) run every 5 minutes.
# INGESTION_DISPATCH_INTERVAL_MS="2000"
# PAYLOAD_EXPIRY_INTERVAL_MS="3600000"
# OPPORTUNITY_CLOCK_INTERVAL_MS="300000"

# Server-only. Spends the provisioning right in app_metadata (ticket 17).
# Never expose it to the browser and never commit its value.
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only Whatsmiau Cloud API v2 account key. Sent as the `apikey` header.
# Never expose it to the browser, the tenant, or logs. Never prefix NEXT_PUBLIC_.
WHATSMIAU_APIKEY=""

