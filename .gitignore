# e no Railway (ADR-0010). Nunca em arquivo local.
.env
.env.*
!.env.example

# Testes e cobertura
coverage/
.vitest/
test-results/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Worktrees dos agentes — árvores de trabalho locais, não fazem parte do repo
.claude/worktrees/

# Deliberadamente versionados — não ignorar:
#   .agents/   skills do projeto
#   .claude/   configuração do harness
#   .scratch/  spec e tickets (é o issue tracker deste repo)
#   docs/      ADRs, pesquisa e plano de construção
