{
  "name": "marctco-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts",
    "test": "vitest --run",
    "test:related": "node scripts/test-related.mjs",
    "test:ci": "vitest --run --coverage.enabled=false",
    "prepare": "node -e \"require('fs').existsSync('.git')&&require('child_process').execSync('lefthook install',{stdio:'inherit'})\"",
    "deploy": "cf deploy",
    "models": "gltfpack -i blender/export/bairro.raw.glb -o public/models/bairro.glb -kn -km -cc"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "lenis": "^1.3.27",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.4",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "cf": "1.0.0-beta.21",
    "gltfpack": "^1.3.0",
    "lefthook": "^2.2.2",
    "oxlint": "^1.89.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
